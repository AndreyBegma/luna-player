{
  "name": "luna-player",
  "version": "0.2.0",
  "description": "The video player lifted out of Luna Watch: HLS, controls, subtitles, keys, TV remotes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreyBegma/luna-player.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./labels": {
      "types": "./dist/labels/index.d.ts",
      "import": "./dist/labels/index.js"
    },
    "./subtitle-appearance": {
      "types": "./dist/logic/subtitle-appearance.d.ts",
      "import": "./dist/logic/subtitle-appearance.js"
    },
    "./resume-policy": {
      "types": "./dist/logic/resume-policy.d.ts",
      "import": "./dist/logic/resume-policy.js"
    },
    "./end-of-stream": {
      "types": "./dist/logic/end-of-stream.d.ts",
      "import": "./dist/logic/end-of-stream.js"
    },
    "./format-time": {
      "types": "./dist/logic/format-time.d.ts",
      "import": "./dist/logic/format-time.js"
    },
    "./seek-geometry": {
      "types": "./dist/logic/seek-geometry.d.ts",
      "import": "./dist/logic/seek-geometry.js"
    },
    "./frame-tap": {
      "types": "./dist/logic/frame-tap.d.ts",
      "import": "./dist/logic/frame-tap.js"
    },
    "./long-press": {
      "types": "./dist/logic/long-press.d.ts",
      "import": "./dist/logic/long-press.js"
    },
    "./hold-seek": {
      "types": "./dist/logic/hold-seek.d.ts",
      "import": "./dist/logic/hold-seek.js"
    },
    "./playback-rate": {
      "types": "./dist/logic/playback-rate.d.ts",
      "import": "./dist/logic/playback-rate.js"
    },
    "./controls-hide": {
      "types": "./dist/logic/controls-hide.d.ts",
      "import": "./dist/logic/controls-hide.js"
    },
    "./centre-transport-visibility": {
      "types": "./dist/logic/centre-transport-visibility.d.ts",
      "import": "./dist/logic/centre-transport-visibility.js"
    },
    "./video-fit": {
      "types": "./dist/logic/video-fit.d.ts",
      "import": "./dist/logic/video-fit.js"
    },
    "./player-keys": {
      "types": "./dist/logic/player-keys.d.ts",
      "import": "./dist/logic/player-keys.js"
    },
    "./volume-wheel": {
      "types": "./dist/logic/volume-wheel.d.ts",
      "import": "./dist/logic/volume-wheel.js"
    },
    "./saved-volume": {
      "types": "./dist/logic/saved-volume.d.ts",
      "import": "./dist/logic/saved-volume.js"
    },
    "./episode-range": {
      "types": "./dist/logic/episode-range.d.ts",
      "import": "./dist/logic/episode-range.js"
    },
    "./platform-types": {
      "types": "./dist/logic/platform-types.d.ts",
      "import": "./dist/logic/platform-types.js"
    },
    "./audio-graph": {
      "types": "./dist/logic/audio-graph.d.ts",
      "import": "./dist/logic/audio-graph.js"
    },
    "./audio-track-labels": {
      "types": "./dist/logic/audio-track-labels.d.ts",
      "import": "./dist/logic/audio-track-labels.js"
    },
    "./sleep-timer": {
      "types": "./dist/logic/sleep-timer.d.ts",
      "import": "./dist/logic/sleep-timer.js"
    },
    "./sleep-fade": {
      "types": "./dist/logic/sleep-fade.d.ts",
      "import": "./dist/logic/sleep-fade.js"
    },
    "./still-watching": {
      "types": "./dist/logic/still-watching.d.ts",
      "import": "./dist/logic/still-watching.js"
    },
    "./sound-mode": {
      "types": "./dist/logic/sound-mode.d.ts",
      "import": "./dist/logic/sound-mode.js"
    },
    "./clock-mode": {
      "types": "./dist/logic/clock-mode.d.ts",
      "import": "./dist/logic/clock-mode.js"
    },
    "./media-query": {
      "types": "./dist/platform/media-query.d.ts",
      "import": "./dist/platform/media-query.js"
    },
    "./tv-spatial": {
      "types": "./dist/platform/tv-spatial.d.ts",
      "import": "./dist/platform/tv-spatial.js"
    },
    "./tv-focusables": {
      "types": "./dist/platform/tv-focusables.d.ts",
      "import": "./dist/platform/tv-focusables.js"
    },
    "./audio-track-language": {
      "types": "./dist/platform/audio-track-language.d.ts",
      "import": "./dist/platform/audio-track-language.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./player.css": "./dist/player/player.css",
    "./hls": {
      "types": "./dist/player/hls.d.ts",
      "import": "./dist/player/hls.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "lint": "biome lint src scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test src",
    "build": "bun scripts/build.ts",
    "build:check": "bun build ./src/index.ts ./src/player/index.ts ./src/player/hls.ts --outdir /tmp/luna-player-check --target browser --external react --external react-dom --external hls.js --external '@andrewbehma/glass-ui/*' --external lucide-react --external 'motion/*'",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "hls.js": "^1.5.0",
    "@andrewbehma/glass-ui": ">=0.20.0",
    "lucide-react": ">=0.400.0",
    "motion": ">=12.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@andrewbehma/glass-ui": "0.34.0",
    "hls.js": "1.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.34.0",
    "motion": "13.1.1",
    "tailwindcss": "4.3.3",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@biomejs/biome": "2.4.10",
    "typescript": "^6.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/bun": "^1.4.0",
    "@happy-dom/global-registrator": "^20.13.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3"
  }
}
